# Contact form delivery (Resend — https://resend.com)
# Without RESEND_API_KEY the contact form still responds OK and logs submissions server-side.
RESEND_API_KEY=
# Verified sender (defaults to Resend's onboarding address until a domain is verified)
CONTACT_FROM_EMAIL="Instituto Curvelo <onboarding@resend.dev>"
# Inbox that receives contact submissions
CONTACT_TO_EMAIL=contato@institutocurvelo.org.br
